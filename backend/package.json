{
  "name": "ferramentacompartilhada-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API local do projeto acadêmico FerramentaCompartilhada",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "nodemon --exec node --env-file-if-exists=.env src/server.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:configure": "node scripts/configure-database-env.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "test:db": "node --env-file=.env --test test/database.test.js",
    "test": "node --env-file=.env --test test/*.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0",
    "multer": "2.5.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "dotenv": "18.0.10",
    "nodemon": "3.1.11",
    "prisma": "7.10.1"
  }
}
